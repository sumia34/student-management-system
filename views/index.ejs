<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Registration</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-5">
    <h2 class="mb-4">User Registration</h2>
    
    <form action="/users/register" method="POST">
      <!-- Name -->
      <div class="mb-3">
        <label for="name" class="form-label">userName</label>
        <input type="text" class="form-control" id="name" name="name" placeholder="Enter your full name" required>
      </div>

      <!-- Age -->
      <div class="mb-3">
        <label for="age" class="form-label">Age</label>
        <input type="number" class="form-control" id="age" name="age" placeholder="Enter your age" required>
      </div>

      <!-- Course -->
      <div class="mb-3">
        <label for="course" class="form-label">Course</label>
        <input type="text" class="form-control" id="course" name="course" placeholder="Enter your course" required>
      </div>

      <!-- Email -->
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email" required>
      </div>

      <!-- Submit Button -->
      <button type="submit" class="btn btn-primary">Register</button>
    </form>
  </div>

  <!-- Bootstrap JS Bundle (Optional for components like modals) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
const searchBox = document.getElementById("searchBox");
const suggestBox = document.getElementById("suggestBox");
const hiddenInput = document.getElementById("hiddenInput");

searchBox.addEventListener("input", async () => {

const value = searchBox.value;

if(value.length === 0){
suggestBox.innerHTML = "";
return;
}

const res = await fetch(`/users/search?name=${value}`);
const data = await res.json();

suggestBox.innerHTML = "";

data.forEach(student => {
const div = document.createElement("div");
div.innerHTML = student.name;
div.style.cursor = "pointer";

div.onclick = () => {
searchBox.value = student.name;
hiddenInput.value = student.name;
suggestBox.innerHTML = "";
};

suggestBox.appendChild(div);
});

hiddenInput.value = value;

});
</script>
</body>

</html>